NODE_ENV=production
NODE_VERSION=22
NPM_CONFIG_PRODUCTION=false

APP_URL=https://tasket.io.vn
CORS_ORIGIN=https://tasket.io.vn,https://www.tasket.io.vn

MONGODB_CONNECTIONSTRING=<PRODUCTION_MONGODB_URI>

JWT_SECRET=<STRONG_PRODUCTION_JWT_SECRET>
JWT_REFRESH_SECRET=<STRONG_PRODUCTION_REFRESH_SECRET>
JWT_EXPIRY=2d
REFRESH_TOKEN_EXPIRY=7d

BETTER_AUTH_SECRET=<STRONG_PRODUCTION_BETTER_AUTH_SECRET>
BETTER_AUTH_URL=https://tasket.io.vn
BETTER_AUTH_TRUSTED_ORIGINS=https://tasket.io.vn,https://www.tasket.io.vn

GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>

RESEND_API_KEY=<RESEND_API_KEY>
EMAIL_FROM=Tasket <notifications@tasket.io.vn>
EMAIL_DEV_REDIRECT_TO_ADMIN=false
ADMIN_EMAIL=<ADMIN_EMAIL>

CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

ABLY_API_KEY=<ABLY_API_KEY>

AI_PROVIDER=auto
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=<GROQ_API_KEY>
