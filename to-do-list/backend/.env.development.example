NODE_ENV=development
PORT=5001
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5001

MONGODB_CONNECTIONSTRING=<LOCAL_OR_DEV_MONGODB_URI>

JWT_SECRET=<DEV_ONLY_SECRET>
JWT_REFRESH_SECRET=<DEV_ONLY_REFRESH_SECRET>
JWT_EXPIRY=2d
REFRESH_TOKEN_EXPIRY=7d

BETTER_AUTH_SECRET=<DEV_BETTER_AUTH_SECRET>
BETTER_AUTH_URL=http://localhost:5001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173

GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>

RESEND_API_KEY=<RESEND_API_KEY>
EMAIL_FROM=Tasket <onboarding@resend.dev>
EMAIL_DEV_REDIRECT_TO_ADMIN=true
ADMIN_EMAIL=<ADMIN_EMAIL>

CLOUD_NAME=<CLOUDINARY_CLOUD_NAME>
CLOUDINARY_API_KEY=<CLOUDINARY_API_KEY>
CLOUDINARY_API_SECRET=<CLOUDINARY_API_SECRET>

ABLY_API_KEY=<ABLY_API_KEY>

AI_PROVIDER=auto
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=<GROQ_API_KEY>
OLLAMA_API_KEY=<OLLAMA_API_KEY>
OLLAMA_MODEL=<OLLAMA_MODEL>
OLLAMA_HOST=http://localhost:11434
