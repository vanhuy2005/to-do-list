MONGODB_CONNECTIONSTRING=mongodb://localhost:27017/todoapp

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Use strong, random 32+ char secrets in production
JWT_SECRET=replace_with_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_different_strong_secret_min_32_chars
JWT_EXPIRY=2d
REFRESH_TOKEN_EXPIRY=7d

# ─── OAuth (optional) ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed for browser requests
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_CREDENTIALS=true
SOCKET_IO_CORS_ORIGIN=http://localhost:5173

# ─── Auth Toggle (development) ───────────────────────────────────────────────
AUTH_ENABLED=true
BYPASS_TASK_AUTH=false

# ─── Email (optional) ────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=your_email@example.com

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com

# ─── Realtime / PubSub keys
ABLY_API_KEY=your_ably_api_key

# ─── Cloudinary (images)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Better Auth (optional)
BETTER_AUTH_SECRET=replace_with_strong_random_secret_min_32_chars
BETTER_AUTH_URL=http://localhost:5001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173
BETTER_AUTH_API_URL=
BETTER_AUTH_KV_URL=
BETTER_AUTH_API_KEY=

# ─── Voice Task AI ───────────────────────────────────────────────────────────
# Multiple keys = comma-separated → auto round-robin rotation (anti-429)
OPENROUTER_API_KEY=sk-or-v1-your_key_1,sk-or-v1-your_key_2
OPENROUTER_API_KEY_1=sk-or-v1-your_fallback_key

AI_PROVIDER=auto
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Gemini (optional)
GEMINI_API_KEY=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-2.5-flash

# GROQ (optional)
GROQ_API_KEY=your_groq_api_key

# Ollama (optional local fallback)
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434

APP_URL=http://localhost:5173

# ─── AI Tuning (optional — leave blank to use defaults) ──────────────────────
# VOICE_CACHE_TTL_MS=600000        # Cache AI result per user+text (10 min)
# VOICE_INFLIGHT_TTL_MS=30000      # Dedup concurrent identical requests (30s)
# VOICE_AI_RETRY_ATTEMPTS=5        # Retry on transient errors (429, 5xx, timeout)
# VOICE_AI_RETRY_BASE_MS=400       # Exponential backoff start
# VOICE_AI_RETRY_MAX_MS=3000       # Backoff ceiling
# VOICE_AI_CONCURRENCY=10          # Parallel AI calls allowed
# VOICE_AI_QUEUE_MAX=50            # Queue depth before 429
# VOICE_RATE_LIMIT_WINDOW_MS=60000 # Per-user window (ms)
# VOICE_RATE_LIMIT_MAX=60          # Max requests per user per window
