# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
MONGODB_CONNECTIONSTRING=mongodb://localhost:27017/ev_charging_db

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production-12345678
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-12345678
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# OAuth Configuration (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Socket.IO Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:3000

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Admin Email
ADMIN_EMAIL=admin@todolist.com
