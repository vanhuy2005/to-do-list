# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
MONGODB_CONNECTIONSTRING=connection_string

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-production-12345678
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production-12345678
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# OAuth Configuration (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# CORS Configuration
CORS_ORIGIN=http://localhost:5000
CORS_CREDENTIALS=true

# Auth Toggle (development)
AUTH_ENABLED=true
BYPASS_TASK_AUTH=false

# Socket.IO Configuration
SOCKET_IO_CORS_ORIGIN=http://localhost:5173

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Admin Email
ADMIN_EMAIL=admin@todolist.com

# Gemini AI Assistant
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
AI_SCOPE_REFUSAL_MESSAGE=Xin loi, toi chi ho tro cac cau hoi lien quan den he thong quan ly cong viec nay.